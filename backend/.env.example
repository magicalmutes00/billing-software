# Render deployment environment variables.
# Copy to .env (never commit) or set them in the Render dashboard.
#
# Required on Render:
#   DATABASE_URL       postgresql+asyncpg://... (from Render PostgreSQL)
#   JWT_SECRET         long random string
#   WEBHOOK_SECRET     long random string
#   CORS_ORIGINS       https://<your-frontend>.onrender.com
#   REDIS_URL          rediss://... (from Render Redis)
#
# Optional:
#   APP_DATABASE_URL   set only if you want a separate non-owner RLS role;
#                      otherwise unset and the app uses DATABASE_URL for everything
#   ACCESS_TOKEN_MINUTES
#   REFRESH_TOKEN_DAYS
#   PORTAL_TOKEN_HOURS
#   PAYMENT_PROVIDER   stub (no live gateway in this phase)
#   STORAGE_DIR        ./storage

ENVIRONMENT=production
DATABASE_URL=postgresql+asyncpg://billing:secret@localhost:5432/billing
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
PORTAL_TOKEN_HOURS=24
PAYMENT_PROVIDER=stub
WEBHOOK_SECRET=dev-webhook-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=./storage
